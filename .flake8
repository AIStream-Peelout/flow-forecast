[flake8]
# Keep CI focused on correctness while the legacy codebase's formatting debt is cleaned
# incrementally. These are Flake8's high-signal syntax and undefined-name checks.
select = E9,F63,F7,F82
exclude = .git,.venv,build,dist,output,output.pth
per-file-ignores =
    flood_forecast/multi_models/crossvivit.py:F722
    flood_forecast/transformer_xl/attn.py:F722
    flood_forecast/transformer_xl/data_embedding.py:F722
